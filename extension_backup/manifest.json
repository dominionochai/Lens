{
  "manifest_version": 3,
  "name": "Cognitive Lens",
  "description": "AI Cognitive Interface Layer",
  "version": "0.1.0",

  "permissions": ["activeTab", "scripting", "storage"],

  "host_permissions": ["http://localhost:3000/*", "https://*/*", "http://*/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js", "inject.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
